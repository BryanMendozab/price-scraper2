# Puerto del servidor Express (el frontend proxea /api hacia aca)
PORT=8787

# Intervalo del scraping automatico, en segundos
CRAWL_INTERVAL_SECONDS=30

# User-Agent que se envia a los sitios. Es buena practica identificarse.
CRAWL_USER_AGENT=AgenteEscolarDemo/1.0 (proyecto escolar de monitoreo de precios)

# Proveedor inicial de notificaciones: none | console | slack | teams
NOTIFY_PROVIDER=console

# Webhooks. Se pueden dejar vacios y cargar los URLs desde la UI (Configuracion).
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# SMTP para alertas por email (Fase 3). También configurable desde la UI.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false + App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
